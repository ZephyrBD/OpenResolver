# 复制为 .env 后按需修改（.env 已在 .gitignore 中）
# 面板管理员密码：仅在 data/admin.json 不存在时用于初始化，写上后即可删除
UGW_ADMIN_PASSWORD=change-me-please

# 宿主端口映射（左侧）。只在本机用建议改成 127.0.0.1:8790:8790
OR_PORT=8790

TZ=Asia/Shanghai

# 部署在 HTTPS 反代之后时置 1
UGW_SECURE_COOKIE=0

UGW_OPEN_MODE=1
UGW_UPSTREAM_TIMEOUT_MS=600000
UGW_MAX_ATTEMPTS=3
ZCODE_APP_VERSION=3.16.3
